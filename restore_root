#!/bin/bash
set -e

# PiOpsOS: Check if we need to restore on first boot
# This runs from a systemd service or via GPIO button

BOOT_FIRMWARE="/boot/firmware"

if [ -f "${BOOT_FIRMWARE}/restore" ]; then
  echo "[PiOpsOS] Restore triggered on boot"

  # Find the overlay partition (p4)
  OVERLAY_DEV=$(df / | tail -1 | awk '{print $1}')
  BASE_DEV=$(echo "$OVERLAY_DEV" | sed -E 's/p?[0-9]+$//')

  # Wipe overlay
  echo "Wiping overlay partition ${OVERLAY_DEV}..."
  wipefs -a "$OVERLAY_DEV" 2>/dev/null || true
  mkfs.ext4 -L "overlay" "$OVERLAY_DEV" -F

  # Reset autoboot to partition 1
  if [ -f "${BOOT_FIRMWARE}/autoboot.txt" ]; then
    cat > "${BOOT_FIRMWARE}/autoboot.txt" <<AUTOFW
[all]
tryboot_a_b=1
boot_partition=1
AUTOFW
  fi

  # Clean up trigger file
  unlink "${BOOT_FIRMWARE}/restore" 2>/dev/null || true

  # Reset cmdline to base rootfs (partition 3)
  sed -i -r "s|root=/dev/${BASE_DEV}[0-9]+|root=/dev/${BASE_DEV}3 rootfstype=ext4 ro|g" "${BOOT_FIRMWARE}/cmdline.txt"

  echo "Restore complete. Rebooting..."
  sleep 3
  reboot
fi

exit 0

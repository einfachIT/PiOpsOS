#!/bin/bash
DEVICE="/dev/sda"
BOOT_MOUNT="/boot/firmware"

if [ -f "${BOOT_MOUNT}/restore" ]; then
    echo Restoring Slot B rootfs from USB...
    dd if=/rootfs.img of=${DEVICE}p5 conv=fsync status=progress bs=4M
    rm -f ${BOOT_MOUNT}/restore
    cp ${BOOT_MOUNT}/firstrun.bak ${BOOT_MOUNT}/firstrun.sh 2>/dev/null || true
    /boot/firmware/boot_to_recovery restore
fi
exit 0

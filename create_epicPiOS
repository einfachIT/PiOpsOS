#!/bin/bash
set -e
set -x

# ==================== CONFIGURATION ====================
DEVICE="/dev/sda"                       # USB stick device (e.g. /dev/sda, /dev/nvme0n1, /dev/mmcblk0)
BOOT_MOUNT="/boot/firmware"             # Use /boot if your distro doesn't use /boot/firmware
WORKDIR="./tmp"

# ==================== FUNCTIONS ====================

# Download and decompress if not already done
download_or_use() {
  local base="$1" url="$2"
  local filename="${url##*/}"
  local img="${WORKDIR}/${base}.img"
  local archive="${WORKDIR}/${filename}"

  [ -f "$img" ] && echo "✓ ${base}.img exists" && return
  [ ! -f "$archive" ] && { echo "Downloading ${filename}..."; curl -L "$url" -o "$archive"; }
  echo "Decompressing ${filename}..."
  unxz "$archive" -c > "$img"
}

# Extract field N from fdisk -lu output for partition P
# Usage: get_fdisk_field IMAGE PARTITION_NUMBER FIELD_NUMBER
get_fdisk_field() {
  local base
  base=$(basename "$1")
  fdisk -lu "$1" | grep -F "${base}${2}" | tr -d '*' | tr -s ' ' | cut -d' ' -f"$3"
}

# Cleanup loop devices and mounts on exit (success or failure)
cleanup() {
  for d in "$BLANK_LOOP" "$RECOVERY_LOOP" "$MAIN_LOOP"; do
    kpartx -d "/dev/loop${d}" 2>/dev/null || true
    losetup -d "/dev/loop${d}" 2>/dev/null || true
  done
  for m in "$SHARED_BOOT_MOUNT" "$SLOT_A_BOOT_MOUNT" "$SLOT_A_ROOTFS_MOUNT" "$SLOT_B_BOOT_MOUNT" "$SLOT_B_ROOTFS_MOUNT"; do
    umount "$m" 2>/dev/null || true
  done
}
trap cleanup EXIT

# ==================== INSTALL SOFTWARE====================
export DEBIAN_FRONTEND=noninteractive
apt update
apt install -y uuid-runtime parted curl unzip kpartx xz-utils fdisk

# ==================== PREPARATION ====================
echo "=== A/B Boot Image Builder (USB/NVMe + Trixie compatible) ==="
mkdir -p "$WORKDIR"

# Accept URLs from args or prompt
RECOVERY_OS_URL="${1:-$(read -r -p "Recovery OS URL: " u; echo $u)}"
MAIN_OS_URL="${2:-$(read -r -p "Main OS URL: " u; echo $u)}"

RECOVERY_OS="${RECOVERY_OS_URL##*/}"
MAIN_OS="${MAIN_OS_URL##*/}"
RECOVERY_OS_BASE="${RECOVERY_OS%.*}"
RECOVERY_OS_BASE="${RECOVERY_OS_BASE%.*}"
MAIN_OS_BASE="${MAIN_OS%.*}"
MAIN_OS_BASE="${MAIN_OS_BASE%.*}"

echo "Recovery OS: ${RECOVERY_OS_BASE}"
echo "Main OS:     ${MAIN_OS_BASE}"

# Download images (deduplicates if both are the same file)
if [ "$RECOVERY_OS" = "$MAIN_OS" ]; then
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
  RECOVERY_OS_BASE="${MAIN_OS_BASE}-recovery"
  [ ! -f "${WORKDIR}/${RECOVERY_OS_BASE}.img" ] && \
    cp "${WORKDIR}/${MAIN_OS_BASE}.img" "${WORKDIR}/${RECOVERY_OS_BASE}.img"
else
  download_or_use "$RECOVERY_OS_BASE" "$RECOVERY_OS_URL"
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
fi

# ==================== CALCULATE PARTITIONS ====================
echo "Calculating partitions..."

# Boot partition (partition 1) info from the OS images
RECOVERY_BOOT_START=$(get_fdisk_field "${WORKDIR}/${RECOVERY_OS_BASE}.img" 1 2)   # start sector
RECOVERY_BOOT_LEN=$(get_fdisk_field "${WORKDIR}/${RECOVERY_OS_BASE}.img" 1 4)    # length
MAIN_BOOT_LEN=$(get_fdisk_field "${WORKDIR}/${MAIN_OS_BASE}.img" 1 4)            # boot partition size from main OS

# Root partition (partition 2) info from the OS images
MAIN_ROOT_LEN=$(get_fdisk_field "${WORKDIR}/${MAIN_OS_BASE}.img" 2 4)            # root partition size from main OS

# A/B Dual Boot Partition Layout (5 partitions):
# p1: Shared boot partition (FAT32)   — bootloader, config.txt, kernel, scripts, autoboot.txt
# p2: Slot A boot partition (FAT32)   — cmdline.txt pointing to Root A (p3)
# p3: Slot A root filesystem (ext4)   — primary working system
# p4: Slot B boot partition (FAT32)   — cmdline.txt pointing to Root B (p5)
# p5: Slot B root filesystem (ext4)   — fallback/backup system
P1_SIZE=$RECOVERY_BOOT_LEN       # Shared boot = recovery boot size
P2_SIZE=$MAIN_BOOT_LEN           # Slot A boot = main OS boot size
P3_SIZE=$MAIN_ROOT_LEN           # Slot A root = main OS root size
P4_SIZE=$MAIN_BOOT_LEN           # Slot B boot = main OS boot size
P5_SIZE=$MAIN_ROOT_LEN           # Slot B root = main OS root size
TOTAL_SECTORS=$((P1_SIZE + P2_SIZE + P3_SIZE + P4_SIZE + P5_SIZE))
IMAGE_MB=$(( (TOTAL_SECTORS * 512 / 4194304) + 1 ))

echo "Image size: ~${IMAGE_MB} MB"

# ==================== CREATE IMAGE ====================
echo "Creating restore image..."
dd if=/dev/zero of="${WORKDIR}/${MAIN_OS_BASE}.restore.img" bs=4M count="$IMAGE_MB" status=progress

UUID_ROOTFS_A=$(uuidgen)
UUID_ROOTFS_B=$(uuidgen)
PARTUUID=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c8)

# Partition layout (A/B dual boot per Raspberry Pi native bootloader docs)
sfdisk "${WORKDIR}/${MAIN_OS_BASE}.restore.img" <<EOF
label: dos
label-id: 0x${PARTUUID}
unit: sectors
1 : start=${RECOVERY_BOOT_START}, size=${P1_SIZE}, type=c
2 : start=$((RECOVERY_BOOT_START + P1_SIZE)), size=${P2_SIZE}, type=c
3 : start=$((RECOVERY_BOOT_START + P1_SIZE + P2_SIZE)), size=${P3_SIZE}, type=83
4 : start=$((RECOVERY_BOOT_START + P1_SIZE + P2_SIZE + P3_SIZE)), size=${P4_SIZE}, type=c
5 : start=$((RECOVERY_BOOT_START + P1_SIZE + P2_SIZE + P3_SIZE + P4_SIZE)), size=${P5_SIZE}, type=83
EOF

# ==================== SETUP LOOP DEVICES ====================
echo "Setting up loop devices..."
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.restore.img"
losetup -v -f "${WORKDIR}/${RECOVERY_OS_BASE}.img"
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.img"

BLANK_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.restore.img" | grep -o '[0-9]*' | head -1)
RECOVERY_LOOP=$(losetup -j "${WORKDIR}/${RECOVERY_OS_BASE}.img" | grep -o '[0-9]*' | head -1)
MAIN_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.img" | grep -o '[0-9]*' | head -1)

kpartx -v -a "/dev/loop${BLANK_LOOP}"
kpartx -v -a "/dev/loop${RECOVERY_LOOP}"
kpartx -v -a "/dev/loop${MAIN_LOOP}"

# ==================== COPY DATA ====================
echo "Copying data to partitions..."

# p1: Shared boot = recovery boot content
dd if="/dev/mapper/loop${RECOVERY_LOOP}p1" of="/dev/mapper/loop${BLANK_LOOP}p1" bs=4M status=progress

# p2: Slot A boot = copy shared boot (will get slot-specific cmdline.txt below)
dd if="/dev/mapper/loop${RECOVERY_LOOP}p1" of="/dev/mapper/loop${BLANK_LOOP}p2" bs=4M status=progress

# p3: Slot A root = main OS root filesystem
dd if="/dev/mapper/loop${MAIN_LOOP}p2" of="/dev/mapper/loop${BLANK_LOOP}p3" bs=4M status=progress

# p4: Slot B boot = copy shared boot (will get slot-specific cmdline.txt below)
dd if="/dev/mapper/loop${RECOVERY_LOOP}p1" of="/dev/mapper/loop${BLANK_LOOP}p4" bs=4M status=progress

# p5: Slot B root = main OS root filesystem
dd if="/dev/mapper/loop${MAIN_LOOP}p2" of="/dev/mapper/loop${BLANK_LOOP}p5" bs=4M status=progress

# ==================== CONFIGURE FILESYSTEMS ====================
echo "Configuring partitions..."

# Label and set UUIDs for both root filesystems
e2label "/dev/mapper/loop${BLANK_LOOP}p3" rootsa
e2fsck -y -f "/dev/mapper/loop${BLANK_LOOP}p3"
tune2fs "/dev/mapper/loop${BLANK_LOOP}p3" -U "$UUID_ROOTFS_A"

e2label "/dev/mapper/loop${BLANK_LOOP}p5" rootsb
e2fsck -y -f "/dev/mapper/loop${BLANK_LOOP}p5"
tune2fs "/dev/mapper/loop${BLANK_LOOP}p5" -U "$UUID_ROOTFS_B"

# ==================== MOUNT AND CONFIGURE ====================
echo "Mounting partitions..."
SHARED_BOOT_MOUNT="${WORKDIR}/mnt/shared_boot"
SLOT_A_BOOT_MOUNT="${WORKDIR}/mnt/slot_a_boot"
SLOT_A_ROOTFS_MOUNT="${WORKDIR}/mnt/slot_a_rootfs"
SLOT_B_BOOT_MOUNT="${WORKDIR}/mnt/slot_b_boot"
SLOT_B_ROOTFS_MOUNT="${WORKDIR}/mnt/slot_b_rootfs"
mkdir -p "$SHARED_BOOT_MOUNT" "$SLOT_A_BOOT_MOUNT" "$SLOT_A_ROOTFS_MOUNT" "$SLOT_B_BOOT_MOUNT" "$SLOT_B_ROOTFS_MOUNT"

mount "/dev/mapper/loop${BLANK_LOOP}p1" "$SHARED_BOOT_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p2" "$SLOT_A_BOOT_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p3" "$SLOT_A_ROOTFS_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p4" "$SLOT_B_BOOT_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p5" "$SLOT_B_ROOTFS_MOUNT"

echo "Configuring boot files..."

# ---- A/B BOOT: Create autoboot.txt on shared boot partition ----
# This file controls the native Pi bootloader A/B selection.
# See: https://github.com/raspberrypi/documentation/blob/master/documentation/asciidoc/computers/config_txt/autoboot.adoc
cat > "${SHARED_BOOT_MOUNT}/autoboot.txt" <<AUTOFW
[all]
tryboot_a_b=1
boot_partition=2
[tryboot]
boot_partition=4
AUTOFW

# ---- Slot A cmdline.txt - point root to partition 3 ----
# USB: /dev/sda3 (no p), NVMe: /dev/nvme0n1p3 (with p)
sed -i -r "s|PARTUUID=.*\\-[0-9]+|${DEVICE}3|" "${SLOT_A_BOOT_MOUNT}/cmdline.txt"

# ---- Slot B cmdline.txt - point root to partition 5 ----
sed -i -r "s|PARTUUID=.*\\-[0-9]+|${DEVICE}5|" "${SLOT_B_BOOT_MOUNT}/cmdline.txt"

# ---- Slot A fstab ----
cat > "${SLOT_A_ROOTFS_MOUNT}/etc/fstab" <<EOF
proc            /proc   proc  defaults       0  0
${DEVICE}1    ${BOOT_MOUNT}  vfat  defaults       0  2
${DEVICE}3     /       ext4  defaults,noatime 0  1
EOF

# ---- Slot B fstab ----
cat > "${SLOT_B_ROOTFS_MOUNT}/etc/fstab" <<EOF
proc            /proc   proc  defaults       0  0
${DEVICE}1    ${BOOT_MOUNT}  vfat  defaults       0  2
${DEVICE}5     /       ext4  defaults,noatime 0  1
EOF

# ---- Copy helper scripts to shared boot partition ----
cp custom.toml               "${SHARED_BOOT_MOUNT}/custom.toml"
cp boot_to_recovery          "${SHARED_BOOT_MOUNT}/"
cp boot_to_root              "${SHARED_BOOT_MOUNT}/"
cp restore_root              "${SHARED_BOOT_MOUNT}/"
cp check_restore_gpio.py     "${SHARED_BOOT_MOUNT}/"

# ---- Add auto-restore systemd service on Slot A rootfs ----
# This runs restore_root on first boot from a fresh USB image
cat > "${SLOT_A_ROOTFS_MOUNT}/etc/systemd/system/restore-root.service" <<EOF
[Unit]
Description=Restore RootFS from USB
DefaultDependencies=no
After=local-fs.target
Before=basic.target

[Service]
Type=oneshot
ExecStart=/boot/firmware/restore_root
RemainAfterExit=yes

[Install]
WantedBy=basic.target
EOF
# Create symlink manually (systemctl doesn't exist in this container)
mkdir -p "${SLOT_A_ROOTFS_MOUNT}/etc/systemd/system/basic.target.wants"
ln -sf "../restore-root.service" "${SLOT_A_ROOTFS_MOUNT}/etc/systemd/system/basic.target.wants/restore-root.service"

# ---- Backup firstrun.sh for recovery (raspberrypi-sys-mods) ----
# These match fixed paths in the firstboot file, use double quotes to expand \$BOOT_MOUNT
sed -i "/^mount \\/boot\\$/a cp /${BOOT_MOUNT}/firstrun.sh /${BOOT_MOUNT}/firstrun.bak" \
  "${SLOT_A_ROOTFS_MOUNT}/usr/lib/raspberrypi-sys-mods/firstboot"
sed -i "/^mount \"\\$FWLOC\" -o rw\\$/a cp /${BOOT_MOUNT}/firstrun.sh /${BOOT_MOUNT}/firstrun.bak" \
  "${SLOT_A_ROOTFS_MOUNT}/usr/lib/raspberrypi-sys-mods/firstboot"

echo ""
echo "=== Done! ==="
echo "Image: ${WORKDIR}/${MAIN_OS_BASE}.restore.img"
echo "Partition layout:"
echo "  p1 (shared boot):  ${P1_SIZE} sectors"
echo "  p2 (slot A boot):  ${P2_SIZE} sectors"
echo "  p3 (slot A root):  ${P3_SIZE} sectors"
echo "  p4 (slot B boot):  ${P4_SIZE} sectors"
echo "  p5 (slot B root):  ${P5_SIZE} sectors"

#!/bin/bash
set -e
set -x

# ==================== CONFIGURATION ====================
BOOT_MOUNT="/boot/firmware"
WORKDIR="./tmp"

# Device to flash to (defaults to /dev/sda for USB, override with DEVICE env var)
DEVICE="${DEVICE:-/dev/sda}"

# ==================== FUNCTIONS ====================

# Download and decompress if not already done
download_or_use() {
  local base="$1" url="$2"
  local filename="${url##*/}"
  local img="${WORKDIR}/${base}.img"
  local archive="${WORKDIR}/${filename}"

  [ -f "$img" ] && echo "✓ ${base}.img exists" && return
  [ ! -f "$archive" ] && { echo "Downloading ${filename}..."; curl -L "$url" -o "$archive"; }
  echo "Decompressing ${filename}..."
  unxz "$archive" -c > "$img"
}

# Cleanup loop devices and mounts on exit (success or failure)
cleanup() {
    local exit_code=$?
    trap - EXIT INT TERM  # Prevent cleanup from running twice
    set +e

    # Tell libdevmapper not to wait on udevd inside Docker
    export DM_DISABLE_UDEV=1

    # 1. Guard against empty WORKDIR so we never unmount /dev
    if [[ -n "${WORKDIR:-}" && -d "${WORKDIR}" ]]; then
        mount | grep -F " ${WORKDIR}" | awk '{print $3}' | sort -r | xargs -r umount -lf
    fi

    # 2. Tear down device-mapper targets and loop devices
    for dev in "${BLANK_LOOP:-}" "${RECOVERY_LOOP:-}" "${MAIN_LOOP:-}"; do
        if [[ -n "$dev" ]]; then
            base=$(basename "$dev")
            kpartx -d "$dev" 2>/dev/null || true

            # Remove any lingering kernel DM maps matching loopXp* directly
            dmsetup ls 2>/dev/null | awk -v prefix="${base}p" '$1 ~ "^"prefix {print $1}' | while read -r map; do
                dmsetup remove -f --noudevsync "$map" 2>/dev/null || true
            done

            losetup -d "$dev" 2>/dev/null || true
        fi
    done

    exit "$exit_code"
}
trap cleanup EXIT INT TERM

# ==================== INSTALL SOFTWARE ====================
export DEBIAN_FRONTEND=noninteractive
apt update
apt install -y uuid-runtime parted curl unzip kpartx xz-utils fdisk e2fsprogs dosfstools

# ==================== PREPARATION ====================
echo "=== PiOpsOS A/B Boot Image Builder (USB/NVMe/SD + Trixie compatible) ==="
mkdir -p "$WORKDIR"

# Accept URLs from args or prompt
RECOVERY_OS_URL="${1:-$(read -r -p "Recovery OS URL: " u; echo $u)}"
MAIN_OS_URL="${2:-$(read -r -p "Main OS URL: " u; echo $u)}"

RECOVERY_OS="${RECOVERY_OS_URL##*/}"
MAIN_OS="${MAIN_OS_URL##*/}"
RECOVERY_OS_BASE="${RECOVERY_OS%.*}"
RECOVERY_OS_BASE="${RECOVERY_OS_BASE%.*}"
MAIN_OS_BASE="${MAIN_OS%.*}"
MAIN_OS_BASE="${MAIN_OS_BASE%.*}"

echo "Recovery OS: ${RECOVERY_OS_BASE}"
echo "Main OS:     ${MAIN_OS_BASE}"

# Download images (deduplicates if both are the same file)
if [ "$RECOVERY_OS" = "$MAIN_OS" ]; then
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
  RECOVERY_OS_BASE="${MAIN_OS_BASE}-recovery"
  [ ! -f "${WORKDIR}/${RECOVERY_OS_BASE}.img" ] && \
    cp "${WORKDIR}/${MAIN_OS_BASE}.img" "${WORKDIR}/${RECOVERY_OS_BASE}.img"
else
  download_or_use "$RECOVERY_OS_BASE" "$RECOVERY_OS_URL"
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
fi

# ==================== FIXED PARTITION SIZES ====================
echo "Using fixed partition sizes..."

# Fixed sizes: P1, P2, P3 are big enough
P1_SIZE=1048576    # Boot A: 512 MB
P2_SIZE=1048576    # Boot B: 512 MB
P3_SIZE=8388608    # Rootfs: 4 GB (big enough for Pi OS + customizations)
P4_SIZE=524288     # Overlay: 256 MB (auto-expanded by growpart on first boot)


echo "Partition sizes:"
echo "  Boot A:   ${P1_SIZE} sectors ($((P1_SIZE * 512 / 1048576)) MB)"
echo "  Boot B:   ${P2_SIZE} sectors ($((P2_SIZE * 512 / 1048576)) MB)"
echo "  Rootfs:   ${P3_SIZE} sectors ($((P3_SIZE * 512 / 1048576)) MB)"
echo "  Overlay:  ${P4_SIZE} sectors ($((P4_SIZE * 512 / 1048576)) MB)"

# ==================== CREATE IMAGE ====================
TOTAL_SECTORS=$((2048 + P1_SIZE + P2_SIZE + P3_SIZE + P4_SIZE))
IMAGE_MB=$(( (TOTAL_SECTORS * 512 / 1048576) + 1 ))
echo "Creating image..."
dd if=/dev/zero of="${WORKDIR}/${MAIN_OS_BASE}.restore.img" bs=1M count="$IMAGE_MB" status=progress


UUID_BASE_ROOT=$(uuidgen)
PARTUUID=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c8)

# Partition layout (4 partitions, MBR compatible)
sfdisk "${WORKDIR}/${MAIN_OS_BASE}.restore.img" <<EOF
label: dos
label-id: 0x${PARTUUID}
unit: sectors
1 : start=2048, size=${P1_SIZE}, type=c
2 : start=$((2048 + P1_SIZE)), size=${P2_SIZE}, type=c
3 : start=$((2048 + P1_SIZE + P2_SIZE)), size=${P3_SIZE}, type=83
4 : start=$((2048 + P1_SIZE + P2_SIZE + P3_SIZE)), size=${P4_SIZE}, type=83
EOF

# ==================== SETUP LOOP DEVICES ====================
echo "Setting up loop devices..."
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.restore.img"
losetup -v -f "${WORKDIR}/${RECOVERY_OS_BASE}.img"
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.img"

BLANK_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.restore.img" | grep -o '[0-9]*' | head -1)
RECOVERY_LOOP=$(losetup -j "${WORKDIR}/${RECOVERY_OS_BASE}.img" | grep -o '[0-9]*' | head -1)
MAIN_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.img" | grep -o '[0-9]*' | head -1)

kpartx -v -a "/dev/loop${BLANK_LOOP}"
kpartx -v -a "/dev/loop${RECOVERY_LOOP}"
kpartx -v -a "/dev/loop${MAIN_LOOP}"

# Force kernel to re-read partition tables (critical in Docker where blkid may return empty)
partprobe "/dev/loop${BLANK_LOOP}" 2>/dev/null || true
partprobe "/dev/loop${RECOVERY_LOOP}" 2>/dev/null || true
partprobe "/dev/loop${MAIN_LOOP}" 2>/dev/null || true
sleep 1

# ==================== FORMAT PARTITIONS ====================
echo "Formatting partitions..."

# Create FAT32 filesystem for boot partitions
mkfs.vfat -F 32 -n "boot_a" "/dev/mapper/loop${BLANK_LOOP}p1"
mkfs.vfat -F 32 -n "boot_b" "/dev/mapper/loop${BLANK_LOOP}p2"

# Create ext4 filesystem for rootfs partition
mkfs.ext4 -L "rootfs" "/dev/mapper/loop${BLANK_LOOP}p3"

# Create ext4 filesystem for overlay partition
mkfs.ext4 -L "overlay" "/dev/mapper/loop${BLANK_LOOP}p4"

# ==================== COPY DATA ====================
echo "Copying data to partitions..."

# p3: Base rootfs = main OS root filesystem (readable, customizable)
dd if="/dev/mapper/loop${MAIN_LOOP}p2" of="/dev/mapper/loop${BLANK_LOOP}p3" bs=4M status=progress

# p4: Overlay — start empty (will fill during first boot)
dd if=/dev/zero of="/dev/mapper/loop${BLANK_LOOP}p4" bs=4M count=0 status=none

# ---- Create mount point for boot B on rootfs ----
mkdir -p "${ROOTFS_MOUNT}/boot/b"

# ==================== MOUNT AND CONFIGURE ====================
echo "Mounting partitions..."
BOOT_A_MOUNT="${WORKDIR}/mnt/boot_a"
BOOT_B_MOUNT="${WORKDIR}/mnt/boot_b"
ROOTFS_MOUNT="${WORKDIR}/mnt/rootfs"
OVERLAY_MOUNT="${WORKDIR}/mnt/overlay"

mkdir -p "$BOOT_A_MOUNT" "$BOOT_B_MOUNT" "$ROOTFS_MOUNT" "$OVERLAY_MOUNT"

mount "/dev/mapper/loop${BLANK_LOOP}p1" "$BOOT_A_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p2" "$BOOT_B_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p3" "$ROOTFS_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p4" "$OVERLAY_MOUNT"

# ---- Copy boot files from recovery image into formatted partitions ----
BOOT_A_SRC="${WORKDIR}/mnt/recovery_boot"
mkdir -p "$BOOT_A_SRC"
mount "/dev/mapper/loop${RECOVERY_LOOP}p1" "$BOOT_A_SRC"
cp -a "$BOOT_A_SRC/." "$BOOT_A_MOUNT/"
cp -a "$BOOT_A_SRC/." "$BOOT_B_MOUNT/"

umount "$BOOT_A_SRC"
rmdir "$BOOT_A_SRC"

echo "Configuring boot files..."

# ---- Extract PARTUUIDs from loop devices ----
# On Mac (Parallels), blkid works fine on loop devices. In Docker Linux,
# blkid may return empty — so retry with partprobe if needed.
get_partuuid() {
  local dev="$1"
  local val
  val=$(blkid -s PARTUUID -o value "$dev" 2>/dev/null)
  if [ -z "$val" ]; then
    local loop=$(echo "$dev" | grep -o 'loop[0-9]*' | tr -dc '0-9')
    partprobe "/dev/loop${loop}" 2>/dev/null || true
    sleep 1
    val=$(blkid -s PARTUUID -o value "$dev" 2>/dev/null)
  fi
  echo "$val"
}

BOOT_A_PARTUUID=$(get_partuuid "/dev/mapper/loop${BLANK_LOOP}p1")
BOOT_B_PARTUUID=$(get_partuuid "/dev/mapper/loop${BLANK_LOOP}p2")
ROOTFS_PARTUUID=$(get_partuuid "/dev/mapper/loop${BLANK_LOOP}p3")
OVERLAY_PARTUUID=$(get_partuuid "/dev/mapper/loop${BLANK_LOOP}p4")

# Validate — fail hard if any PARTUUID is empty
for name in BOOT_A_PARTUUID BOOT_B_PARTUUID ROOTFS_PARTUUID OVERLAY_PARTUUID; do
  eval "val=\$${name}"
  if [ -z "$val" ]; then
    echo "❌ FATAL: $name PARTUUID is empty! Aborting."
    exit 1
  fi
done

echo "Partition PARTUUIDs:"
echo "  boot_a:  $BOOT_A_PARTUUID"
echo "  boot_b:  $BOOT_B_PARTUUID"
echo "  rootfs:  $ROOTFS_PARTUUID"
echo "  overlay: $OVERLAY_PARTUUID"

# ---- autoboot.txt — controls which boot partition gets mounted ----
cat > "${BOOT_A_MOUNT}/autoboot.txt" <<AUTOFW
[all]
boot_partition=1
AUTOFW

# ---- cmdline.txt — both point root to p3 (base rootfs) ----
# p1 (boot_a) → no overlay (rollback mode)
sed -i -r "s|root=PARTUUID=[^ ]+|root=PARTUUID=${ROOTFS_PARTUUID}|g" "${BOOT_A_MOUNT}/cmdline.txt"
# p2 (boot_b) → with overlay (normal mode)
sed -i -r "s|root=PARTUUID=[^ ]+|root=PARTUUID=${ROOTFS_PARTUUID}|g" "${BOOT_B_MOUNT}/cmdline.txt"
sed -i -r "s| rootwait| rootwait overlayroot=device:dev=/dev/disk/by-partuuid/${OVERLAY_PARTUUID},fstype=ext4,mkfs=0 systemd.mask=systemd-remount-fs.service|g" "${BOOT_B_MOUNT}/cmdline.txt"
# Then replace fsck.repair=yes with fsck.mode=skip (don't fsck read-only root)
sed -i -r 's|fsck\.repair=yes|fsck.mode=skip|g' "${BOOT_A_MOUNT}/cmdline.txt"
sed -i -r 's|fsck\.repair=yes|fsck.mode=skip|g' "${BOOT_B_MOUNT}/cmdline.txt"

# ---- fstab on base rootfs — mount boot A by default, NO overlay ----
# overlay is managed by overlayroot.service, not fstab
cat > "${ROOTFS_MOUNT}/etc/fstab" <<EOF
PARTUUID=${ROOTFS_PARTUUID}  /           ext4  defaults,noatime  0  1
proc            /proc   proc  defaults       0  0
PARTUUID=${BOOT_A_PARTUUID}  ${BOOT_MOUNT}  vfat  defaults       0  2
EOF

# ---- Cloud-init vendor-data: install overlayroot, configure boot_b, and set up tryboot reset ----
cat > "${BOOT_A_MOUNT}/vendor-data" <<'EOF'
Content-Type: multipart/mixed; boundary="==PIOPS_BOUNDARY=="
MIME-Version: 1.0

--==PIOPS_BOUNDARY==
Content-Type: text/cloud-config; charset="us-ascii"

#cloud-config
# Reboots into boot_b ONLY after scripts-vendor AND user-data's runcmd finish
power_state:
  delay: now
  mode: reboot
  message: "PiOpsOS first-boot provisioning complete; switching to boot_b"
  timeout: 30
  condition: test -f /run/vendor-switch-slot-b

--==PIOPS_BOUNDARY==
Content-Type: text/x-shellscript; charset="us-ascii"

#!/bin/bash
set -euxo pipefail

# Guard: do nothing if already booted into an active overlayroot
if findmnt -n -o FSTYPE / | grep -qx "overlay"; then
  exit 0
fi

# 1. Resolve live partition devices by udev label (immune to stale /etc/blkid.tab cache)
DEV_BOOT_B=$(readlink -f /dev/disk/by-label/boot_b)
DEV_OVERLAY=$(readlink -f /dev/disk/by-label/overlay)

BOOT_B_PARTUUID=$(lsblk -no PARTUUID "$DEV_BOOT_B")
OVERLAY_PARTUUID=$(lsblk -no PARTUUID "$DEV_OVERLAY")

# 2. Install overlayroot and cloud-guest-utils (growpart), ignoring pre-NTP clock skew
echo "Installing overlayroot:"
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=120 -o Acquire::Check-Date=false update
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=120 install -y overlayroot cloud-guest-utils


# 3. Mount boot_b temporarily, copy initramfs, and unmount cleanly
mkdir -p /mnt/boot_b
mount -t vfat -o rw "$DEV_BOOT_B" /mnt/boot_b

echo "cp results:"
find /boot/firmware -maxdepth 1 -name 'initramfs*' -type f -exec cp -v {} /mnt/boot_b/ \;

umount /mnt/boot_b
rmdir /mnt/boot_b

# 4. Expand Partition 4 (overlay) to fill the remainder of the drive
DISK_DEV="/dev/$(lsblk -no PKNAME "$DEV_OVERLAY")"
PART_NUM=$(cat "/sys/class/block/$(basename "$DEV_OVERLAY")/partition")

rc=0
growpart "$DISK_DEV" "$PART_NUM" || rc=$?
[ "$rc" -eq 0 ] || [ "$rc" -eq 1 ]
udevadm settle --timeout=10

# 5. Write unified reset-overlay.sh on boot_a (kept out of shared rootfs)
cat > /boot/firmware/reset-overlay.sh <<RESET
#!/bin/sh
set -eux

MODE="\${1:-}"
TRYBOOT_FILE="/proc/device-tree/chosen/bootloader/tryboot"
BOOT_B_PARTUUID="${BOOT_B_PARTUUID}"
PART_OVERLAY="/dev/disk/by-partuuid/${OVERLAY_PARTUUID}"

IS_TRYBOOT="0"
if [ -r "\$TRYBOOT_FILE" ] && [ "\$(od -An -tu4 --endian=big "\$TRYBOOT_FILE" | tr -d ' \n')" = "1" ]; then
  IS_TRYBOOT="1"
fi

if [ "\$MODE" = "--init" ] || [ "\$IS_TRYBOOT" = "1" ]; then
  udevadm settle --timeout=10

  # Format Partition 4 (overlay) cleanly as ext4
  mkfs.ext4 -F -L overlay "\$PART_OVERLAY"

  # Override boot-firmware.mount via systemd drop-in in Partition 4's overlay upperdir only
  mkdir -p /mnt/overlay
  mount "\$PART_OVERLAY" /mnt/overlay
  mkdir -p /mnt/overlay/overlay/etc/systemd/system/boot-firmware.mount.d
  cat > /mnt/overlay/overlay/etc/systemd/system/boot-firmware.mount.d/override.conf <<DROPIN
[Mount]
What=/dev/disk/by-partuuid/\${BOOT_B_PARTUUID}
DROPIN
  umount /mnt/overlay
  rmdir /mnt/overlay

  if [ "\$IS_TRYBOOT" = "1" ]; then
    systemctl --no-block reboot
  fi
fi
RESET

# 6. Wire reset-overlay.sh into boot_a/cmdline.txt and configure autoboot.txt
if ! grep -q "systemd.run=" /boot/firmware/cmdline.txt; then
  sed -i 's|$| systemd.run="/bin/sh /boot/firmware/reset-overlay.sh" systemd.run_success_action=none systemd.run_failure_action=none systemd.wants=kernel-command-line.service|' /boot/firmware/cmdline.txt
fi

cat > /boot/firmware/autoboot.txt <<'AUTOBOOT'
[all]
tryboot_a_b=1
boot_partition=2

[tryboot]
boot_partition=1
AUTOBOOT

# 7. Run initial Partition 4 format & overlay fstab update (IS_TRYBOOT=0, so cloud-init handles reboot)
/bin/sh /boot/firmware/reset-overlay.sh --init
sync

# Uncomment for production auto-reboot into boot_b after first-boot provisioning completes:
touch /run/vendor-switch-slot-b

--==PIOPS_BOUNDARY==--
EOF
echo "Vendor-data written to ${BOOT_A_MOUNT}/vendor-data"

# ---- Copy helper scripts to boot A partition ----
cp boot_to_recovery          "${BOOT_B_MOUNT}/"


# ---- Cleanup mounts ----
echo "Unmounting..."
umount "$BOOT_A_MOUNT"
umount "$BOOT_B_MOUNT"
umount "$ROOTFS_MOUNT"
umount "$OVERLAY_MOUNT"

echo ""
echo "=== Done! ==="
echo "Image: ${WORKDIR}/${MAIN_OS_BASE}.restore.img"
echo "Device used: ${DEVICE}"
echo "Partition layout:"
echo "  p1 (boot_a):    ${P1_SIZE} sectors ($((P1_SIZE * 512 / 1048576)) MB)   (FAT32)"
echo "  p2 (boot_b):    ${P2_SIZE} sectors ($((P2_SIZE * 512 / 1048576)) MB)   (FAT32)"
echo "  p3 (rootfs):    ${P3_SIZE} sectors ($((P3_SIZE * 512 / 1048576)) MB)   (ext4, read-write)"
echo "  p4 (overlay):   ${P4_SIZE} sectors ($((P4_SIZE * 512 / 1048576)) MB)   (ext4, wiped for reset)"
echo ""
echo "Boot behavior:"
echo "  - Boot mounts p2 (base rootfs) read-only"
echo "  - overlayroot mounts p4 as writable overlay on top"
echo "  - All changes (logs, configs, packages) go to p4"
echo "  - Rebooting preserves p2, p4 survives"
echo "  - Factory reset: wipe p4, reboot (restores to customized p2)"
echo "  - Kernel update: new files copied to other boot partition, autoboot.txt toggled"
echo ""
echo "To flash:"
echo "  export DEVICE=/dev/sdX"
echo "  sudo dd if=${WORKDIR}/${MAIN_OS_BASE}.restore.img of=\$DEVICE bs=4M status=progress"
echo "  sudo sync"

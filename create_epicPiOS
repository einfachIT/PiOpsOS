#!/bin/bash
set -e
set -x

# ==================== CONFIGURATION ====================
DEVICE="/dev/sda"                       # USB stick device (e.g. /dev/sda, /dev/nvme0n1, /dev/mmcblk0)
BOOT_MOUNT="/boot/firmware"             # Use /boot if your distro doesn't use /boot/firmware
WORKDIR="./tmp"

# ==================== FUNCTIONS ====================

# Download and decompress if not already done
download_or_use() {
  local base="$1" url="$2"
  local filename="${url##*/}"
  local img="${WORKDIR}/${base}.img"
  local archive="${WORKDIR}/${filename}"

  [ -f "$img" ] && echo "✓ ${base}.img exists" && return
  [ ! -f "$archive" ] && { echo "Downloading ${filename}..."; curl -L "$url" -o "$archive"; }
  echo "Decompressing ${filename}..."
  unxz "$archive" -c > "$img"
}

# Extract field N from fdisk -lu output for partition P
# Usage: get_fdisk_field IMAGE PARTITION_NUMBER FIELD_NUMBER
get_fdisk_field() {
  local base
  base=$(basename "$1")
  fdisk -lu "$1" | grep -F "${base}${2}" | tr -d '*' | tr -s ' ' | cut -d' ' -f"$3"
}

# Cleanup loop devices and mounts on exit (success or failure)
cleanup() {
  echo "Cleaning up..."

  # 1. Unmount all mount points first (before kpartx/losetup)
  for m in "$BOOT_MOUNT_MOUNT" "$ROOTFS_MOUNT" "$OVERLAY_MOUNT"; do
    if mountpoint -q "$m" 2>/dev/null; then
      umount "$m" 2>/dev/null || true
    fi
  done

  sleep 2  # Give kernel time to release devices

  # 2. Remove kpartx mappings
  losetup -a | grep -E '\.(restore|lite|img)$' | cut -d: -f1 | while read -r dev; do
    kpartx -d "$dev" 2>/dev/null || true
  done

  # 3. Detach all our loop devices
  losetup -a | grep -E '\.(restore|lite|img)$' | cut -d: -f1 | while read -r dev; do
    losetup -d "$dev" 2>/dev/null || true
  done

  # 4. Force cleanup any remaining orphans
  losetup -a | grep -E 'loop[0-9]+' | grep -E '\.(restore|img)$' | cut -d: -f1 | while read -r dev; do
    umount -l "$dev"* 2>/dev/null || true
    kpartx -d "$dev" 2>/dev/null || true
    losetup -d "$dev" 2>/dev/null || true
  done

  echo "Cleanup complete."
}
trap cleanup EXIT

# ==================== INSTALL SOFTWARE====================
export DEBIAN_FRONTEND=noninteractive
apt update
apt install -y uuid-runtime parted curl unzip kpartx xz-utils fdisk e2fsprogs

# ==================== PREPARATION ====================
echo "=== OverlayFS Root Image Builder (USB/NVMe + Trixie compatible) ==="
mkdir -p "$WORKDIR"

# Accept URLs from args or prompt
RECOVERY_OS_URL="${1:-$(read -r -p "Recovery OS URL: " u; echo $u)}"
MAIN_OS_URL="${2:-$(read -r -p "Main OS URL: " u; echo $u)}"

RECOVERY_OS="${RECOVERY_OS_URL##*/}"
MAIN_OS="${MAIN_OS_URL##*/}"
RECOVERY_OS_BASE="${RECOVERY_OS%.*}"
RECOVERY_OS_BASE="${RECOVERY_OS_BASE%.*}"
MAIN_OS_BASE="${MAIN_OS%.*}"
MAIN_OS_BASE="${MAIN_OS_BASE%.*}"

echo "Recovery OS: ${RECOVERY_OS_BASE}"
echo "Main OS:     ${MAIN_OS_BASE}"

# Download images (deduplicates if both are the same file)
if [ "$RECOVERY_OS" = "$MAIN_OS" ]; then
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
  RECOVERY_OS_BASE="${MAIN_OS_BASE}-recovery"
  [ ! -f "${WORKDIR}/${RECOVERY_OS_BASE}.img" ] && \
    cp "${WORKDIR}/${MAIN_OS_BASE}.img" "${WORKDIR}/${RECOVERY_OS_BASE}.img"
else
  download_or_use "$RECOVERY_OS_BASE" "$RECOVERY_OS_URL"
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
fi

# ==================== CALCULATE PARTITIONS ====================
echo "Calculating partitions..."

# Boot partition (partition 1) info from the OS images
RECOVERY_BOOT_START=$(get_fdisk_field "${WORKDIR}/${RECOVERY_OS_BASE}.img" 1 2)   # start sector
RECOVERY_BOOT_LEN=$(get_fdisk_field "${WORKDIR}/${RECOVERY_OS_BASE}.img" 1 4)    # length
MAIN_BOOT_LEN=$(get_fdisk_field "${WORKDIR}/${MAIN_OS_BASE}.img" 1 4)            # boot partition size from main OS

# Root partition (partition 2) info from the OS images
MAIN_ROOT_LEN=$(get_fdisk_field "${WORKDIR}/${MAIN_OS_BASE}.img" 2 4)            # root partition size from main OS

# OverlayFS Partition Layout (3 partitions — MBR compatible):
# p1: Boot partition (FAT32)         — bootloader, kernel, scripts, custom.toml
# p2: Base rootfs (ext4, read-only)  — full Pi OS Trixie with customizations baked in
# p3: Overlay (ext4, read-write)     — runtime changes, logs, configs (survives reboot)
P1_SIZE=$RECOVERY_BOOT_LEN        # Boot partition = recovery boot size
P2_SIZE=$MAIN_ROOT_LEN            # Base rootfs = main OS root size
P3_SIZE=2097152                   # Overlay = 1 GB (2 * 1024 * 1024 sectors)
TOTAL_SECTORS=$((RECOVERY_BOOT_START + P1_SIZE + P2_SIZE + P3_SIZE))
IMAGE_MB=$(( (TOTAL_SECTORS * 512 / 4194304) + 1 ))

echo "Image size: ~${IMAGE_MB} MB"

# ==================== CREATE IMAGE ====================
echo "Creating restore image..."
dd if=/dev/zero of="${WORKDIR}/${MAIN_OS_BASE}.restore.img" bs=4M count="$IMAGE_MB" status=progress

UUID_BASE_ROOT=$(uuidgen)
PARTUUID=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c8)

# Partition layout (3 partitions, MBR compatible)
sfdisk "${WORKDIR}/${MAIN_OS_BASE}.restore.img" <<EOF
label: dos
label-id: 0x${PARTUUID}
unit: sectors
1 : start=${RECOVERY_BOOT_START}, size=${P1_SIZE}, type=c
2 : start=$((RECOVERY_BOOT_START + P1_SIZE)), size=${P2_SIZE}, type=83
3 : start=$((RECOVERY_BOOT_START + P1_SIZE + P2_SIZE)), size=${P3_SIZE}, type=83
EOF

# ==================== SETUP LOOP DEVICES ====================
echo "Setting up loop devices..."
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.restore.img"
losetup -v -f "${WORKDIR}/${RECOVERY_OS_BASE}.img"
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.img"

BLANK_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.restore.img" | grep -o '[0-9]*' | head -1)
RECOVERY_LOOP=$(losetup -j "${WORKDIR}/${RECOVERY_OS_BASE}.img" | grep -o '[0-9]*' | head -1)
MAIN_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.img" | grep -o '[0-9]*' | head -1)

kpartx -v -a "/dev/loop${BLANK_LOOP}"
kpartx -v -a "/dev/loop${RECOVERY_LOOP}"
kpartx -v -a "/dev/loop${MAIN_LOOP}"

# ==================== COPY DATA ====================
echo "Copying data to partitions..."

# p1: Boot partition = recovery boot content
dd if="/dev/mapper/loop${RECOVERY_LOOP}p1" of="/dev/mapper/loop${BLANK_LOOP}p1" bs=4M status=progress

# p2: Base rootfs = main OS root filesystem (read-only, immutable base)
dd if="/dev/mapper/loop${MAIN_LOOP}p2" of="/dev/mapper/loop${BLANK_LOOP}p2" bs=4M status=progress

# p3: Overlay — start empty (will fill during first boot)
dd if=/dev/zero of="/dev/mapper/loop${BLANK_LOOP}p3" bs=4M count=0 status=none

# ==================== FORMAT OVERLAY PARTITION ====================
echo "Formatting overlay partition..."

# Create ext4 filesystem for overlay partition
mkfs.ext4 -L "overlay" "/dev/mapper/loop${BLANK_LOOP}p3"

# ==================== MOUNT AND CONFIGURE ====================
echo "Mounting partitions..."
BOOT_MOUNT_MOUNT="${WORKDIR}/mnt/boot"
ROOTFS_MOUNT="${WORKDIR}/mnt/rootfs"
OVERLAY_MOUNT="${WORKDIR}/mnt/overlay"

mkdir -p "$BOOT_MOUNT_MOUNT" "$ROOTFS_MOUNT" "$OVERLAY_MOUNT"

mount "/dev/mapper/loop${BLANK_LOOP}p1" "$BOOT_MOUNT_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p2" "$ROOTFS_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p3" "$OVERLAY_MOUNT"

echo "Configuring boot files..."

# ---- bootloader: autoboot.txt on boot partition ----
cat > "${BOOT_MOUNT_MOUNT}/autoboot.txt" <<AUTOFW
[all]
tryboot_a_b=1
boot_partition=1
AUTOFW

# ---- cmdline.txt - point root to partition 2 (base rootfs, read-only) ----
sed -i -r "s|root=PARTUUID=.*|root=/dev/${DEVICE}2 rootfstype=ext4 ro|" "${BOOT_MOUNT_MOUNT}/cmdline.txt"

# ---- fstab on base rootfs ----
cat > "${ROOTFS_MOUNT}/etc/fstab" <<EOF
proc            /proc   proc  defaults       0  0
${DEVICE}1    ${BOOT_MOUNT}  vfat  defaults       0  2
EOF

# ---- Configure overlayroot ----
# This tells Pi OS to mount p3 as the overlay writable layer
# overlayroot.conf is read by the initramfs during boot
cat > "${ROOTFS_MOUNT}/etc/overlayroot.conf" <<EOF
overlayroot="overlayfs:dev=/dev/${DEVICE}3"
EOF

# ---- Copy helper scripts to boot partition ----
cp custom.toml               "${BOOT_MOUNT_MOUNT}/custom.toml"
cp boot_to_recovery          "${BOOT_MOUNT_MOUNT}/"
cp boot_to_root              "${BOOT_MOUNT_MOUNT}/"
cp restore_root              "${BOOT_MOUNT_MOUNT}/"
cp check_restore_gpio.py     "${BOOT_MOUNT_MOUNT}/"

# ---- Backup firstrun.sh for recovery (raspberrypi-sys-mods) ----
sed -i "/^mount \\/boot\$/a cp /${BOOT_MOUNT}/firstrun.sh /${BOOT_MOUNT}/firstrun.bak" \
  "${ROOTFS_MOUNT}/usr/lib/raspberrypi-sys-mods/firstboot"
sed -i "/^mount \"\$FWLOC\" -o rw\$/a cp /${BOOT_MOUNT}/firstrun.sh /${BOOT_MOUNT}/firstrun.bak" \
  "${ROOTFS_MOUNT}/usr/lib/raspberrypi-sys-mods/firstboot"

echo ""
echo "=== Done! ==="
echo "Image: ${WORKDIR}/${MAIN_OS_BASE}.restore.img"
echo "Partition layout:"
echo "  p1 (boot):       ${P1_SIZE} sectors   (FAT32)"
echo "  p2 (base rootfs): ${P2_SIZE} sectors   (ext4, read-only)"
echo "  p3 (overlay):    ${P3_SIZE} sectors   (ext4, overlay root)"
echo ""
echo "Boot behavior:"
echo "  - Boot mounts p2 (base rootfs) read-only"
echo "  - overlayroot mounts p3 as writable overlay on top"
echo "  - All changes (logs, configs, packages) go to p3"
echo "  - Rebooting preserves p2, p3 survives"
echo "  - Factory reset: wipe p3, reboot (restores to customized p2)"

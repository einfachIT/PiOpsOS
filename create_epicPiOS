#!/bin/bash
set -e
set -x

# ==================== CONFIGURATION ====================
DEVICE="/dev/sda"                       # USB stick device
BOOT_MOUNT="/boot/firmware"             # Use /boot if your distro doesn't use /boot/firmware
WORKDIR="./tmp"

# ==================== FUNCTIONS ====================

# Download and decompress if not already done
download_or_use() {
  local base="$1" url="$2"
  local filename="${url##*/}"
  local img="${WORKDIR}/${base}.img"
  local archive="${WORKDIR}/${filename}"

  [ -f "$img" ] && echo "✓ ${base}.img exists" && return
  [ ! -f "$archive" ] && { echo "Downloading ${filename}..."; curl -L "$url" -o "$archive"; }
  echo "Decompressing ${filename}..."
  unxz "$archive" -c > "$img"
}

# Extract field N from fdisk -lu output for partition P
# Usage: get_fdisk_field IMAGE PARTITION_NUMBER FIELD_NUMBER
get_fdisk_field() {
  local base
  base=$(basename "$1")
  fdisk -lu "$1" | grep -F "${base}${2}" | tr -d '*' | tr -s ' ' | cut -d' ' -f"$3"
}

# Cleanup loop devices and mounts on exit (success or failure)
cleanup() {
  for d in "$BLANK_LOOP" "$RECOVERY_LOOP" "$MAIN_LOOP"; do
    kpartx -d "/dev/loop${d}" 2>/dev/null || true
    losetup -d "/dev/loop${d}" 2>/dev/null || true
  done
  for m in "${RECOVERY_BOOT_MOUNT}" "${RECOVERY_ROOT_MOUNT}" "${ROOTFS_MOUNT}"; do
    umount "$m" 2>/dev/null || true
  done
}
trap cleanup EXIT

# ==================== INSTALL SOFTWARE====================
export DEBIAN_FRONTEND=noninteractive
apt update
apt install -y uuid-runtime parted curl unzip kpartx xz-utils fdisk


# ==================== PREPARATION ====================
echo "=== USB Restore Image Builder ==="
mkdir -p "$WORKDIR"

# Accept URLs from args or prompt
RECOVERY_OS_URL="${1:-$(read -r -p "Recovery OS URL: " u; echo $u)}"
MAIN_OS_URL="${2:-$(read -r -p "Main OS URL: " u; echo $u)}"

RECOVERY_OS="${RECOVERY_OS_URL##*/}"
MAIN_OS="${MAIN_OS_URL##*/}"
RECOVERY_OS_BASE="${RECOVERY_OS%.*}"
RECOVERY_OS_BASE="${RECOVERY_OS_BASE%.*}"
MAIN_OS_BASE="${MAIN_OS%.*}"
MAIN_OS_BASE="${MAIN_OS_BASE%.*}"

echo "Recovery OS: ${RECOVERY_OS_BASE}"
echo "Main OS:     ${MAIN_OS_BASE}"

# Download images (deduplicates if both are the same file)
if [ "$RECOVERY_OS" = "$MAIN_OS" ]; then
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
  RECOVERY_OS_BASE="${MAIN_OS_BASE}-recovery"
  [ ! -f "${WORKDIR}/${RECOVERY_OS_BASE}.img" ] && \
    cp "${WORKDIR}/${MAIN_OS_BASE}.img" "${WORKDIR}/${RECOVERY_OS_BASE}.img"
else
  download_or_use "$RECOVERY_OS_BASE" "$RECOVERY_OS_URL"
  download_or_use "$MAIN_OS_BASE" "$MAIN_OS_URL"
fi

# ==================== CALCULATE PARTITIONS ====================
echo "Calculating partitions..."

# Boot partition (partition 1) info
RECOVERY_BOOT_START=$(get_fdisk_field "${WORKDIR}/${RECOVERY_OS_BASE}.img" 1 2)   # start sector
RECOVERY_BOOT_LEN=$(get_fdisk_field "${WORKDIR}/${RECOVERY_OS_BASE}.img" 1 4)    # length
MAIN_BOOT_LEN=$(get_fdisk_field "${WORKDIR}/${MAIN_OS_BASE}.img" 1 4)            # FIXED: was -f 2

# Root partition (partition 2) info
RECOVERY_ROOT_LEN=$(get_fdisk_field "${WORKDIR}/${RECOVERY_OS_BASE}.img" 2 4)
MAIN_ROOT_LEN=$(get_fdisk_field "${WORKDIR}/${MAIN_OS_BASE}.img" 2 4)

# Partition sizes and layout
P1_SIZE=$RECOVERY_BOOT_LEN
P2_SIZE=$((RECOVERY_ROOT_LEN + MAIN_ROOT_LEN))
P3_SIZE=$MAIN_ROOT_LEN
TOTAL_SECTORS=$((P1_SIZE + MAIN_BOOT_LEN + P2_SIZE + P3_SIZE))
IMAGE_MB=$(( (TOTAL_SECTORS * 512 / 4194304) + 1 ))

echo "Image size: ~${IMAGE_MB} MB"

# ==================== CREATE IMAGE ====================
echo "Creating restore image..."
dd if=/dev/zero of="${WORKDIR}/${MAIN_OS_BASE}.restore.img" bs=4M count="$IMAGE_MB" status=progress

UUID_RESTORE=$(uuidgen)
UUID_ROOTFS=$(uuidgen)
PARTUUID=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c8)

# Partition layout:
# p1: Recovery boot
# p2: Recovery root  (+ main boot space reserved)
# p3: Main root
sfdisk "${WORKDIR}/${MAIN_OS_BASE}.restore.img" <<EOF
label: dos
label-id: 0x${PARTUUID}
unit: sectors
1 : start=${RECOVERY_BOOT_START}, size=${P1_SIZE}, type=c
2 : start=$((RECOVERY_BOOT_START + P1_SIZE)), size=${P2_SIZE}, type=83
3 : start=$((RECOVERY_BOOT_START + P1_SIZE + P2_SIZE)), size=${P3_SIZE}, type=83
EOF

# ==================== SETUP LOOP DEVICES ====================
echo "Setting up loop devices..."
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.restore.img"
losetup -v -f "${WORKDIR}/${RECOVERY_OS_BASE}.img"
losetup -v -f "${WORKDIR}/${MAIN_OS_BASE}.img"

BLANK_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.restore.img" | grep -o '[0-9]*' | head -1)
RECOVERY_LOOP=$(losetup -j "${WORKDIR}/${RECOVERY_OS_BASE}.img" | grep -o '[0-9]*' | head -1)
MAIN_LOOP=$(losetup -j "${WORKDIR}/${MAIN_OS_BASE}.img" | grep -o '[0-9]*' | head -1)

kpartx -v -a "/dev/loop${BLANK_LOOP}"
kpartx -v -a "/dev/loop${RECOVERY_LOOP}"
kpartx -v -a "/dev/loop${MAIN_LOOP}"

# ==================== COPY DATA ====================
echo "Copying data to partitions..."
dd if="/dev/mapper/loop${RECOVERY_LOOP}p1" of="/dev/mapper/loop${BLANK_LOOP}p1" bs=4M status=progress
dd if="/dev/mapper/loop${RECOVERY_LOOP}p2" of="/dev/mapper/loop${BLANK_LOOP}p2" bs=4M status=progress
dd if="/dev/mapper/loop${MAIN_LOOP}p2" of="/dev/mapper/loop${BLANK_LOOP}p3" bs=4M status=progress

# ==================== CONFIGURE FILESYSTEMS ====================
echo "Configuring partitions..."
tune2fs "/dev/mapper/loop${BLANK_LOOP}p2" -U "$UUID_RESTORE"
e2label "/dev/mapper/loop${BLANK_LOOP}p2" recoveryfs
e2fsck -y -f "/dev/mapper/loop${BLANK_LOOP}p3"
tune2fs "/dev/mapper/loop${BLANK_LOOP}p3" -U "$UUID_ROOTFS"
e2fsck -pf "/dev/mapper/loop${BLANK_LOOP}p2"
resize2fs "/dev/mapper/loop${BLANK_LOOP}p2"

# ==================== MOUNT AND CONFIGURE ====================
echo "Mounting partitions..."
RECOVERY_BOOT_MOUNT="${WORKDIR}/mnt/restore_boot"
RECOVERY_ROOT_MOUNT="${WORKDIR}/mnt/restore_recovery"
ROOTFS_MOUNT="${WORKDIR}/mnt/restore_rootfs"
mkdir -p "$RECOVERY_BOOT_MOUNT" "$RECOVERY_ROOT_MOUNT" "$ROOTFS_MOUNT"

mount "/dev/mapper/loop${BLANK_LOOP}p1" "$RECOVERY_BOOT_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p2" "$RECOVERY_ROOT_MOUNT"
mount "/dev/mapper/loop${BLANK_LOOP}p3" "$ROOTFS_MOUNT"

echo "Configuring boot files..."

# cmdline.txt - point root to USB partition 3
sed -i -r "s|PARTUUID=.*\-02|${DEVICE}p3|" "$RECOVERY_BOOT_MOUNT/cmdline.txt"

# Generate boot UUID for fstab
BOOT_UUID=$(blkid -o export "/dev/mapper/loop${BLANK_LOOP}p1" | grep '^UUID=' | cut -d'=' -f2)

# Write rootfs fstab
cat > "${ROOTFS_MOUNT}/etc/fstab" <<EOF
proc             /proc   proc  defaults       0  0
${DEVICE}p1      ${BOOT_MOUNT}  vfat  defaults       0  2
${DEVICE}p3      /       ext4  defaults,noatime 0  1
EOF

# Write recovery fstab
cat > "${RECOVERY_ROOT_MOUNT}/etc/fstab" <<EOF
proc             /proc   proc  defaults       0  0
${DEVICE}p1      ${BOOT_MOUNT}  vfat  defaults       0  2
${DEVICE}p2      /       ext4  defaults,noatime 0  1
EOF

# Copy helper scripts to boot partition
cp custom.toml               "${RECOVERY_BOOT_MOUNT}/custom.toml.bak"
cp boot_to_recovery          "${RECOVERY_BOOT_MOUNT}/"
cp boot_to_root              "${RECOVERY_BOOT_MOUNT}/"
cp restore_root              "${RECOVERY_BOOT_MOUNT}/"
cp check_restore_gpio.py     "${RECOVERY_BOOT_MOUNT}/"

# Add auto-restore in recovery partition 
cat > "${ROOTFS_MOUNT}/etc/systemd/system/restore-root.service" <<EOF
[Unit]
Description=Restore RootFS from USB
DefaultDependencies=no
After=local-fs.target
Before=basic.target

[Service]
Type=oneshot
ExecStart=/boot/firmware/restore_root
RemainAfterExit=yes

[Install]
WantedBy=basic.target
EOF
# Create symlink manually (systemctl doesn't exist in this container)
mkdir -p "${ROOTFS_MOUNT}/etc/systemd/system/basic.target.wants"
ln -sf "../restore-root.service" "${ROOTFS_MOUNT}/etc/systemd/system/basic.target.wants/restore-root.service"

# Backup firstrun.sh for recovery (raspberrypi-sys-mods)
# Note: these match fixed paths in the file, use double quotes to expand $BOOT_MOUNT
sed -i "/^mount \/boot\$/a cp /${BOOT_MOUNT}/firstrun.sh /${BOOT_MOUNT}/firstrun.bak" \
  "${ROOTFS_MOUNT}/usr/lib/raspberrypi-sys-mods/firstboot"
sed -i "/^mount \"\$FWLOC\" -o rw\$/a cp /${BOOT_MOUNT}/firstrun.sh /${BOOT_MOUNT}/firstrun.bak" \
  "${ROOTFS_MOUNT}/usr/lib/raspberrypi-sys-mods/firstboot"

# Create recovery rootfs image from partition 3
echo "Creating recovery rootfs image..."
dd if="/dev/mapper/loop${BLANK_LOOP}p3" of="${RECOVERY_ROOT_MOUNT}/rootfs.img" bs=4M status=progress

echo ""
echo "=== Done! ==="
echo "Image: ${WORKDIR}/${MAIN_OS_BASE}.restore.img"
echo "Recovery image: ${RECOVERY_ROOT_MOUNT}/rootfs.img"


#!/bin/bash
set -e

if [ "$EUID" -ne 0 ]; then
  echo "Please run as root"
  exit 1
fi

echo "[PiOpsOS] Switching boot partition..."

BOOT_FIRMWARE="/boot/firmware"
BOOT_OTHER="/boot/b"

# Detect which boot partition is currently active
CURRENT_PART=$(grep -oP 'boot_partition=\K[0-9]+' "${BOOT_FIRMWARE}/autoboot.txt" 2>/dev/null || echo "1")

if [ "$CURRENT_PART" = "1" ]; then
  echo "Currently on boot A (partition 1) → switching to boot B (partition 2)"
  # Copy current boot files to boot B (in case they haven't been synced)
  if mountpoint -q "${BOOT_OTHER}" 2>/dev/null; then
    rsync -av --delete \
      --exclude="cmdline.txt" \
      --exclude="autoboot.txt" \
      --exclude="custom.toml" \
      "${BOOT_FIRMWARE}/" "${BOOT_OTHER}/"
  fi
  # Toggle autoboot.txt to boot partition 2
  cat > "${BOOT_FIRMWARE}/autoboot.txt" <<AUTOFW
[all]
boot_partition=2
AUTOFW
else
  echo "Currently on boot B (partition 2) → switching to boot A (partition 1)"
  cat > "${BOOT_FIRMWARE}/autoboot.txt" <<AUTOFW
[all]
boot_partition=1
AUTOFW
fi

echo "Rebooting in 10 seconds..."
sleep 10

reboot
exit 0

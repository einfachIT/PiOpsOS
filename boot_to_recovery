#!/bin/bash
if [ "$EUID" -ne 0 ]
  then echo "Please run as root"
  exit
fi

echo Factory resetting overlay partition and rebooting in 5 seconds
sleep 5

if [ "$1" = "restore" ]; then
    echo Automatic restore selected
    dd if=/dev/zero of=/dev/sda3 bs=4M status=progress
    touch /boot/firmware/restore
fi

( sleep 10; reboot ) &

exit 0
